# Configure these as RunPod secrets/environment variables. Never commit values.
OPENROUTER_API_KEY=
HF_TOKEN=
CIVITAI_TOKEN=
JUPYTER_TOKEN=

# Optional: comma-separated CivitAI MODEL VERSION IDs.
MMH3_LORA_VERSION_IDS=

# Runtime switches.
