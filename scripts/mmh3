#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="/opt/venv/bin:$PATH"
export PYTHONPATH="/opt/mmh3/runtime${PYTHONPATH:+:$PYTHONPATH}"

cmd="${1:-status}"
case "$cmd" in
  status)
    python - <<'PY'
from pathlib import Path
import json
from mmh3.hardware import detect
from mmh3 import comfy
h=detect(); print("=== MMH3 STATUS ===")
print(f"GPU: {h.gpu_name} | VRAM: {h.vram_mib} MiB")
print(f"RAM cgroup: {h.cgroup_memory_current_bytes/2**30:.1f} / {h.cgroup_memory_limit_bytes/2**30:.1f} GiB")
print("Comfy:", "ready" if comfy.wait_ready(1) else "down")
for name in ("hardware.json","memory.json","provisioning.json"):
    p=Path("/workspace/mmh3/state")/name
    if p.exists():
        try:
            d=json.loads(p.read_text())
            if name=="provisioning.json":
                print("Provisioning:", d.get("status"), "-", d.get("message") or d.get("stage"))
        except Exception:
            pass
        print(f"{name}: {p}")
PY
    ;;
  doctor)
    phone="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:7860/api/info 2>/dev/null || echo FAIL)"
    comfy="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8188/system_stats 2>/dev/null || echo FAIL)"
    jupyter="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8888/ 2>/dev/null || echo FAIL)"
    echo "=== MMH3 DOCTOR ==="
    echo "Phone 7860:   $phone"
    echo "Comfy 8188:  $comfy"
    echo "Jupyter 8888:$jupyter"
    echo
    echo "--- processes ---"
    ps -eo pid,etime,%cpu,%mem,cmd | grep -E '[C]omfyUI/main.py|[s]ervices/phone-ui/server.py|[j]upyter-lab|[m]mh3.supervisor|[m]mh3.provisioner' || true
    echo
    echo "--- GPU ---"
    nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null || echo "nvidia-smi unavailable"
    echo
    echo "--- RAM ---"
    python - <<'PY'
from pathlib import Path
try:
    cur=int(Path("/sys/fs/cgroup/memory.current").read_text())
    raw=Path("/sys/fs/cgroup/memory.max").read_text().strip()
    lim=int(raw) if raw!="max" else 0
    if lim:
        print(f"{cur/2**30:.1f} / {lim/2**30:.1f} GiB ({cur/lim:.0%})")
    else:
        print(f"{cur/2**30:.1f} GiB used; no finite cgroup limit")
except Exception as e:
    print("cgroup memory unavailable:",e)
PY
    echo
    echo "--- startup timing ---"
    cat /workspace/mmh3/state/startup.json 2>/dev/null || echo "No startup timing state."
    echo
    echo "--- provisioning ---"
    cat /workspace/mmh3/state/provisioning.json 2>/dev/null || echo "No provisioning state."
    echo
    if [[ "$phone" == "200" && "$comfy" == "200" && ( "$jupyter" == "200" || "$jupyter" == "302" || "$jupyter" == "403" ) ]]; then
      echo "VERDICT: local container services are healthy. If RunPod links are unavailable, suspect RunPod proxy/host state."
    else
      echo "VERDICT: one or more local services are unhealthy; inspect mmh3 logs-* before blaming the RunPod proxy."
    fi
    ;;
  gpu-smoke)
    python - <<'PY'
import torch
print("torch:", torch.__version__, "cuda build:", torch.version.cuda)
if not torch.cuda.is_available():
    raise SystemExit("CUDA is not available inside the container")
dev=torch.device("cuda")
print("GPU:", torch.cuda.get_device_name(0))
a=torch.randn((1024,1024),device=dev,dtype=torch.float16)
b=torch.randn((1024,1024),device=dev,dtype=torch.float16)
c=a@b
torch.cuda.synchronize()
print("CUDA matmul OK:", tuple(c.shape), c.dtype)
import triton
print("triton:", triton.__version__)
import sageattention
print("sageattention import: OK")
import onnxruntime as ort
providers=ort.get_available_providers()
print("onnxruntime:", providers)
if "CUDAExecutionProvider" not in providers:
    raise SystemExit("ONNX Runtime CUDAExecutionProvider missing")
print("GPU smoke: PASS")
PY
    ;;
  free)
    python - <<'PY'
from mmh3.comfy import free_memory
print("cleanup requested" if free_memory(True,True) else "cleanup request failed")
PY
    ;;
  interrupt)
    python - <<'PY'
from mmh3.comfy import interrupt
print("interrupt requested" if interrupt() else "interrupt request failed")
PY
    ;;
  restart-comfy)
    pgrep -f '[p]ython.*[/]ComfyUI/main.py' | xargs -r kill
    echo "ComfyUI stop requested; MMH3 supervisor will restart it."
    ;;
  restart-phone)
    pgrep -f '[p]ython.*services/phone-ui/server.py' | xargs -r kill
    echo "Phone UI stop requested; MMH3 supervisor will restart it."
    ;;
  provision)
    if pgrep -f '[p]ython.*-m [m]mh3.provisioner' >/dev/null 2>&1; then
      echo "MMH3 provisioner is already running."
    else
      python -m mmh3.provisioner
    fi
    ;;
  sync-loras)
    python - <<'PY'
from pathlib import Path
from mmh3.loras import sync_loras
result=sync_loras(Path('/workspace/mmh3/config/loras.yaml'))
print("managed:", len(result.get("managed",[])), "local:", len(result.get("unmanaged",[])))
for x in result.get("managed",[]):
    print(x.get("status"), x.get("version_id"), x.get("nickname") or x.get("filename") or x.get("error"))
PY
    ;;
  sync-models)
    python - <<'PY'
from pathlib import Path
from mmh3.models import sync_models
for x in sync_models(Path('/opt/mmh3/config/models.yaml')): print(x)
PY
    ;;
  provision-status)
    cat /workspace/mmh3/state/provisioning.json 2>/dev/null || echo "No provisioning state yet."
    ;;
  jupyter-url)
    python - <<'PY'
import os
from urllib.parse import quote
pod=os.environ.get("RUNPOD_POD_ID","").strip()
port=os.environ.get("MMH3_JUPYTER_PORT","8888").strip() or "8888"
token=os.environ.get("JUPYTER_TOKEN","")
if not pod:
    raise SystemExit("RUNPOD_POD_ID is not set; use the RunPod HTTP service URL for port "+port)
url=f"https://{pod}-{port}.proxy.runpod.net/lab"
if token:
    url += "?token=" + quote(token, safe="")
print(url)
PY
    ;;
  logs-comfy) tail -n 200 -f /workspace/mmh3/logs/comfyui.log ;;
  logs-phone) tail -n 200 -f /workspace/mmh3/logs/phone-ui.log ;;
  logs-memory) tail -n 200 -f /workspace/mmh3/logs/memory-guard.log ;;
  logs-provisioning) tail -n 200 -f /workspace/mmh3/logs/provisioning.log ;;
  *)
    echo "Usage: mmh3 {status|doctor|gpu-smoke|free|interrupt|restart-comfy|restart-phone|provision|sync-models|sync-loras|provision-status|jupyter-url|logs-comfy|logs-phone|logs-memory|logs-provisioning}"
    exit 2
    ;;
esac
