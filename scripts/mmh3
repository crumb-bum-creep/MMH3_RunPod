#!/usr/bin/env bash
set -Eeuo pipefail

CMD="${1:-help}"
LOG_DIR="${MMH3_LOG_DIR:-/workspace/mmh3/logs}"
COMFY_DIR="${MMH3_COMFY_DIR:-/workspace/ComfyUI}"
PHONE_DIR="${MMH3_PHONE_DIR:-/workspace/h3_phone_ui_7860}"
mkdir -p "$LOG_DIR"

comfy_pid() { pgrep -f '[p]ython.*main.py.*8188' | head -1 || true; }
phone_pid() { pgrep -f '[p]ython.*server.py.*7860' | head -1 || true; }

status() {
  echo "=== MMH3 STATUS ==="
  printf "ComfyUI:  "; [ -n "$(comfy_pid)" ] && echo "running ($(comfy_pid))" || echo "stopped"
  printf "Phone UI: "; [ -n "$(phone_pid)" ] && echo "running ($(phone_pid))" || echo "stopped"
  echo
  nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>/dev/null || true
  free -h | sed -n '1,2p' || true
}

start_comfy() {
  [ -f "$COMFY_DIR/main.py" ] || { echo "Missing $COMFY_DIR/main.py"; exit 1; }
  cd "$COMFY_DIR"
  nohup python3 main.py --listen 0.0.0.0 --port 8188 >"$LOG_DIR/comfyui.log" 2>&1 &
  echo "ComfyUI started."
}

stop_comfy() {
  local p; p="$(comfy_pid)"
  [ -n "$p" ] && kill "$p" || true
}

start_phone() {
  [ -f "$PHONE_DIR/server.py" ] || { echo "Missing $PHONE_DIR/server.py"; exit 1; }
  cd "$PHONE_DIR"
  nohup python3 server.py --port 7860 --comfy http://127.0.0.1:8188 >"$LOG_DIR/phone-ui.log" 2>&1 &
  echo "Phone UI started."
}

stop_phone() {
  local p; p="$(phone_pid)"
  [ -n "$p" ] && kill "$p" || true
}

case "$CMD" in
  status) status ;;
  start-comfy) start_comfy ;;
  stop-comfy) stop_comfy ;;
  restart-comfy) stop_comfy; sleep 2; start_comfy ;;
  start-phone) start_phone ;;
  stop-phone) stop_phone ;;
  restart-phone) stop_phone; sleep 1; start_phone ;;
  logs-comfy) tail -n 100 -f "$LOG_DIR/comfyui.log" ;;
  logs-phone) tail -n 100 -f "$LOG_DIR/phone-ui.log" ;;
  *)
    echo "Usage: mmh3 {status|start-comfy|stop-comfy|restart-comfy|start-phone|stop-phone|restart-phone|logs-comfy|logs-phone}"
    ;;
esac
