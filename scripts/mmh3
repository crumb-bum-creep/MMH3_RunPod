#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="/opt/venv/bin:$PATH"
export PYTHONPATH="/opt/mmh3/runtime${PYTHONPATH:+:$PYTHONPATH}"

cmd="${1:-status}"
case "$cmd" in
  status)
    python - <<'PY'
from pathlib import Path
import json
from mmh3.hardware import detect
from mmh3 import comfy
h=detect(); print("=== MMH3 STATUS ===")
print(f"GPU: {h.gpu_name} | VRAM: {h.vram_mib} MiB")
print(f"RAM cgroup: {h.cgroup_memory_current_bytes/2**30:.1f} / {h.cgroup_memory_limit_bytes/2**30:.1f} GiB")
print("Comfy:", "ready" if comfy.wait_ready(1) else "down")
for name in ("hardware.json","memory.json","provisioning.json"):
    p=Path("/workspace/mmh3/state")/name
    if p.exists():
        try:
            d=json.loads(p.read_text())
            if name=="provisioning.json":
                print("Provisioning:", d.get("status"), "-", d.get("message") or d.get("stage"))
        except Exception:
            pass
        print(f"{name}: {p}")
PY
    ;;
  free)
    python - <<'PY'
from mmh3.comfy import free_memory
print("cleanup requested" if free_memory(True,True) else "cleanup request failed")
PY
    ;;
  interrupt)
    python - <<'PY'
from mmh3.comfy import interrupt
print("interrupt requested" if interrupt() else "interrupt request failed")
PY
    ;;
  restart-comfy)
    pgrep -f '[p]ython.*[/]ComfyUI/main.py' | xargs -r kill
    echo "ComfyUI stop requested; MMH3 supervisor will restart it."
    ;;
  restart-phone)
    pgrep -f '[p]ython.*services/phone-ui/server.py' | xargs -r kill
    echo "Phone UI stop requested; MMH3 supervisor will restart it."
    ;;
  provision)
    if pgrep -f '[p]ython.*-m [m]mh3.provisioner' >/dev/null 2>&1; then
      echo "MMH3 provisioner is already running."
    else
      python -m mmh3.provisioner
    fi
    ;;
  sync-loras)
    python - <<'PY'
from pathlib import Path
from mmh3.loras import sync_loras
result=sync_loras(Path('/workspace/mmh3/config/loras.yaml'))
print("managed:", len(result.get("managed",[])), "local:", len(result.get("unmanaged",[])))
for x in result.get("managed",[]):
    print(x.get("status"), x.get("version_id"), x.get("nickname") or x.get("filename") or x.get("error"))
PY
    ;;
  sync-models)
    python - <<'PY'
from pathlib import Path
from mmh3.models import sync_models
for x in sync_models(Path('/opt/mmh3/config/models.yaml')): print(x)
PY
    ;;
  provision-status)
    cat /workspace/mmh3/state/provisioning.json 2>/dev/null || echo "No provisioning state yet."
    ;;
  jupyter-url)
    python - <<'PY'
import os
from urllib.parse import quote
pod=os.environ.get("RUNPOD_POD_ID","").strip()
port=os.environ.get("MMH3_JUPYTER_PORT","8888").strip() or "8888"
token=os.environ.get("JUPYTER_TOKEN","")
if not pod:
    raise SystemExit("RUNPOD_POD_ID is not set; use the RunPod HTTP service URL for port "+port)
url=f"https://{pod}-{port}.proxy.runpod.net/lab"
if token:
    url += "?token=" + quote(token, safe="")
print(url)
PY
    ;;
  logs-comfy) tail -n 200 -f /workspace/mmh3/logs/comfyui.log ;;
  logs-phone) tail -n 200 -f /workspace/mmh3/logs/phone-ui.log ;;
  logs-memory) tail -n 200 -f /workspace/mmh3/logs/memory-guard.log ;;
  logs-provisioning) tail -n 200 -f /workspace/mmh3/logs/provisioning.log ;;
  *)
    echo "Usage: mmh3 {status|free|interrupt|restart-comfy|restart-phone|provision|sync-models|sync-loras|provision-status|jupyter-url|logs-comfy|logs-phone|logs-memory|logs-provisioning}"
    exit 2
    ;;
esac
